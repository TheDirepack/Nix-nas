{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nas.local/schemas/feature-catalog.schema.json",
  "title": "NixOS NAS runtime feature catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "features"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "features": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/feature" }
    },
    "memoryComponents": {
      "type": "array",
      "items": { "$ref": "#/$defs/memoryComponent" }
    }
  },
  "$defs": {
    "unitList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "startupEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warm": { "type": ["string", "integer"] },
        "first": { "type": ["string", "integer"] }
      }
    },
    "availabilityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["path", "device-any", "executable", "systemd-unit", "tcp", "http"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        },
        "unit": { "type": "string", "minLength": 1 },
        "host": { "enum": ["127.0.0.1", "localhost", "::1"] },
        "port": { "$ref": "#/$defs/port" },
        "url": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]+)?/" },
        "description": { "type": "string" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "allowedModes", "defaultMode", "startUnits"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "available": { "type": "boolean" },
        "allowedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["off", "on-demand", "always"] },
          "contains": { "const": "off" }
        },
        "defaultMode": { "enum": ["off", "on-demand", "always"] },
        "legacyTrueMode": { "enum": ["on-demand", "always"] },
        "parent": { "type": "string", "minLength": 1 },
        "access": { "enum": ["admin", "ai", "authenticated", "network"] },
        "allowNetworkWake": { "type": "boolean" },
        "idleSeconds": { "type": "integer", "minimum": 1 },
        "startupTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "startupEstimateSeconds": { "$ref": "#/$defs/startupEstimate" },
        "availabilityProbe": { "$ref": "#/$defs/availabilityProbe" },
        "healthPort": { "$ref": "#/$defs/port" },
        "healthUrl": { "type": "string", "minLength": 1 },
        "healthUrls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "activePorts": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" },
          "uniqueItems": true
        },
        "startUnits": { "$ref": "#/$defs/unitList" },
        "stopUnits": { "$ref": "#/$defs/unitList" },
        "restartRequired": { "type": "boolean" }
      }
    },
    "memoryComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "minMiB", "typicalMiB", "maxMiB", "units"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "installed": { "type": "boolean" },
        "minMiB": { "type": "integer", "minimum": 0 },
        "typicalMiB": { "type": "integer", "minimum": 0 },
        "maxMiB": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" },
        "units": { "$ref": "#/$defs/unitList" }
      }
    }
  }
}
