{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixos-nas.local/schemas/managed-service.schema.json",
  "title": "NixOS NAS managed service (file-based, no SQLite)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "services"],
  "$defs": {
    "storageResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "stateClass", "capabilities", "backup"],
      "properties": {
        "path": {"type": "string", "pattern": "^/(tank|srv|var/lib/nas-control/apps)(/.*)?$"},
        "dataset": {"type": "string", "pattern": "^tank/.+"},
        "scope": {"enum": ["system", "user", "instance"], "default": "system"},
        "pathTemplate": {"type": "string", "pattern": "^/(tank|srv|var/lib/nas-control/apps)/.+"},
        "stateClass": {"enum": ["authoritative", "derived", "cache", "ephemeral"]},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["read", "write", "move", "delete", "admin"]}
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "consistency": {"enum": ["filesystem", "zfs-snapshot", "postgres", "native", "none"], "default": "filesystem"}
          }
        },
        "fileBrowser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": {"type": "boolean", "default": true}
          }
        },
        "quotaBytes": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "maxLength": 256}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "user"}}, "required": ["scope"]},
          "then": {"required": ["pathTemplate"]}
        }
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outboundDefault": {"enum": ["allow", "deny"]},
        "lanAccess": {"type": "boolean"},
        "allowedHostPorts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "allowedEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr"],
            "properties": {
              "cidr": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]+$"},
              "ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
            }
          }
        }
      }
    },
    "lifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["persistent", "on-demand", "session"]},
        "idleSeconds": {"type": "integer", "minimum": 30, "maximum": 604800}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "on-demand"}}, "required": ["mode"]},
          "then": {"required": ["idleSeconds"]}
        },
        {
          "if": {"properties": {"mode": {"enum": ["persistent", "session"]}}, "required": ["mode"]},
          "then": {"not": {"required": ["idleSeconds"]}}
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": {"enum": ["quadlet", "compose", "vm", "systemd", "external", "native"]},
        "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
        "source": {"type": "string", "minLength": 1},
        "units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.@:-]+\\.(service|socket|target|timer|path)$"}
        },
        "startPolicy": {
          "enum": ["boot", "manual", "on-demand", "disabled"],
          "description": "Deprecated migration input; canonical V2 uses service.lifecycle plus service.enabled."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "systemd"}}, "required": ["type"]},
          "then": {
            "required": ["units"],
            "properties": {
              "source": {"type": "string", "pattern": "^systemd/[A-Za-z0-9_.@:-]+\\.(service|socket|target|timer|path)$"}
            }
          },
          "else": {
            "if": {"properties": {"type": {"enum": ["quadlet", "compose", "vm"]}}, "required": ["type"]},
            "then": {
              "properties": {
                "source": {"type": "string", "pattern": "^/var/lib/nas-control/apps/[a-z0-9-]+/.+$"}
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {"const": 2},
    "generation": {"type": "integer", "minimum": 1},
    "storageResources": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,47}$"},
      "additionalProperties": {"$ref": "#/$defs/storageResource"}
    },
    "networkProfiles": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,47}$"},
      "additionalProperties": {"$ref": "#/$defs/networkPolicy"}
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "enabled", "runtime"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$"},
          "description": {"type": "string", "maxLength": 256},
          "ownership": {"enum": ["system", "runtime"], "default": "runtime"},
          "enabled": {"type": "boolean"},
          "generation": {"type": "integer", "minimum": 1},
          "principal": {"type": "string", "pattern": "^application:[a-z][a-z0-9-]{0,47}$"},
          "lifecycle": {"$ref": "#/$defs/lifecyclePolicy"},
          "portal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visible": {"type": "boolean"},
              "category": {"enum": ["Files", "Media", "AI", "Home", "Tools", "Monitoring", "Administration", "Other"]},
              "icon": {"type": "string", "pattern": "^[a-z0-9-]+$"}
            }
          },
          "runtime": {"$ref": "#/$defs/runtime"},
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memoryBytes": {"type": "integer", "minimum": 67108864, "maximum": 68719476736},
              "cpus": {"type": "number", "minimum": 0.1, "maximum": 64},
              "gpus": {"type": "array", "items": {"type": "string"}}
            }
          },
          "storage": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["hostPath", "guestPath", "mode"],
                  "properties": {
                    "hostPath": {"type": "string", "pattern": "^/(tank|srv|var/lib/nas-control/apps)/.+"},
                    "guestPath": {"type": "string", "pattern": "^/.+"},
                    "mode": {"enum": ["ro", "rw"]},
                    "dataset": {"type": "string", "pattern": "^tank/.+"},
                    "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["resource", "guestPath"],
                  "properties": {
                    "resource": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
                    "guestPath": {"type": "string", "pattern": "^/.+"},
                    "target": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                      "description": "Runtime-specific destination identity: Compose service name or libvirt filesystem target."
                    },
                    "requiredCapabilities": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {"enum": ["read", "write", "move", "delete", "admin"]}
                    }
                  }
                }
              ]
            }
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "targetPort", "exposure", "auth"],
              "properties": {
                "transport": {"enum": ["http", "https", "tcp", "udp", "ws"]},
                "targetService": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535},
                "exposure": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": {"enum": ["none", "path", "hostname", "dns", "port"]},
                    "value": {"type": "string", "minLength": 1, "maxLength": 253},
                    "prefix": {"type": "boolean"}
                  }
                },
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode"],
                  "properties": {
                    "mode": {"enum": ["public", "forward-auth", "oidc"]},
                    "capability": {"type": "string", "pattern": "^(application|storage)\\.[a-z][a-z0-9-]{0,47}\\.[a-z][a-z0-9-]{0,47}$"},
                    "allow": {"enum": ["any", "groups", "users", "all"]},
                    "groups": {"type": "array", "items": {"type": "string", "pattern": "^([A-Za-z0-9_-]+|[0-9a-fA-F-]{36}|\\d+)$"}},
                    "users": {"type": "array", "items": {"type": "string", "pattern": "^([A-Za-z0-9._-]+|[0-9a-fA-F-]{36}|\\d+)$"}}
                  }
                },
                "portal": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "visible": {"type": "boolean"},
                    "category": {"enum": ["Files", "Media", "AI", "Home", "Tools", "Monitoring", "Administration", "Other"]},
                    "icon": {"type": "string", "pattern": "^[a-z0-9-]+$"}
                  }
                }
              }
            }
          },
          "networkProfile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
          "network": {"$ref": "#/$defs/networkPolicy"}
        }
      }
    }
  }
}
