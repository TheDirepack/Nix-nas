{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixos-nas.local/schemas/managed-services-v3.schema.json",
  "title": "NixOS NAS Managed Services V2",
  "description": "GUI-first declarative desired-state contract. Applications are data; V2 owns generic lifecycle, dependencies, runtime, resources and projections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "services"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "unit": {"type": "string", "pattern": "^[A-Za-z0-9_.@:-]+\\.(service|socket|target|timer|path)$"},
    "environment": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "additionalProperties": {"type": "string"}, "default": {}},
    "storageResource": {"title": "Storage resource", "type": "object", "additionalProperties": false, "required": ["path", "stateClass", "capabilities", "backup"], "properties": {"path": {"$ref": "#/$defs/absolutePath", "title": "Host path"}, "dataset": {"type": "string", "title": "ZFS dataset"}, "scope": {"enum": ["system", "user", "instance"], "default": "system"}, "pathTemplate": {"$ref": "#/$defs/absolutePath"}, "stateClass": {"enum": ["authoritative", "derived", "cache", "ephemeral"]}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "write", "move", "delete", "admin"]}}, "backup": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "consistency": {"enum": ["filesystem", "zfs-snapshot", "native", "none"], "default": "filesystem"}}}, "fileBrowser": {"type": "object", "additionalProperties": false, "properties": {"visible": {"type": "boolean", "default": true}}}, "quotaBytes": {"type": "integer", "minimum": 0}, "description": {"type": "string", "maxLength": 256}}},
    "networkPolicy": {"title": "Network policy", "type": "object", "additionalProperties": false, "properties": {"mode": {"enum": ["host", "isolated", "none"], "default": "host"}, "outboundDefault": {"enum": ["allow", "deny"], "default": "allow"}, "lanAccess": {"type": "boolean", "default": false}, "allowedHostPorts": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}, "allowedEgress": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cidr"], "properties": {"cidr": {"type": "string"}, "ports": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}}}}}},
    "credential": {"title": "Credential reference", "type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "pattern": "^/run/nas-secrets/[A-Za-z0-9._/-]+$"}, "required": {"type": "boolean", "default": true}, "description": {"type": "string", "maxLength": 256}}},
    "schedule": {"type": "object", "additionalProperties": false, "properties": {"calendar": {"type": "string", "minLength": 1, "maxLength": 128}, "intervalSeconds": {"type": "integer", "minimum": 60, "maximum": 31536000}, "randomizedDelaySeconds": {"type": "integer", "minimum": 0, "maximum": 604800, "default": 0}, "persistent": {"type": "boolean", "default": true}}, "oneOf": [{"required": ["calendar"]}, {"required": ["intervalSeconds"]}]},
    "workload": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "activation"], "properties": {"kind": {"const": "daemon"}, "activation": {"enum": ["persistent", "on-demand"]}, "idleSeconds": {"type": "integer", "minimum": 30, "maximum": 604800}}, "allOf": [{"if": {"properties": {"activation": {"const": "on-demand"}}}, "then": {"required": ["idleSeconds"]}}]}, {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "job"}, "schedules": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/schedule"}, "default": []}}}, {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "session"}, "leaseIdleSeconds": {"type": "integer", "minimum": 30, "maximum": 86400, "default": 900}}}]},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["service"], "properties": {"service": {"$ref": "#/$defs/id"}, "condition": {"enum": ["started", "ready", "completed"], "default": "ready"}}},
    "probe": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "unit"], "properties": {"type": {"const": "systemd"}, "unit": {"$ref": "#/$defs/unit"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "port"], "properties": {"type": {"const": "tcp"}, "host": {"type": "string", "default": "127.0.0.1"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, {"type": "object", "additionalProperties": false, "required": ["type", "url"], "properties": {"type": {"const": "http"}, "url": {"type": "string", "pattern": "^https?://"}, "acceptStatusMin": {"type": "integer", "minimum": 100, "maximum": 599, "default": 200}, "acceptStatusMax": {"type": "integer", "minimum": 100, "maximum": 599, "default": 399}}}, {"type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": {"type": {"const": "path"}, "path": {"$ref": "#/$defs/absolutePath"}}}]},
    "readiness": {"type": "object", "additionalProperties": false, "required": ["probes"], "properties": {"timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 60}, "intervalMilliseconds": {"type": "integer", "minimum": 100, "maximum": 10000, "default": 500}, "probes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/probe"}}}},
    "accelerator": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "gpu"}, "vendor": {"enum": ["any", "nvidia", "amd", "intel"], "default": "any"}, "quantity": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 16}, {"const": "all"}], "default": 1}, "device": {"type": "string"}, "required": {"type": "boolean", "default": false}, "mode": {"enum": ["shared", "passthrough"], "default": "shared"}, "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"}}},
    "resources": {"type": "object", "additionalProperties": false, "properties": {"memoryHighBytes": {"type": "integer", "minimum": 16777216}, "memoryMaxBytes": {"type": "integer", "minimum": 16777216}, "cpus": {"type": "number", "minimum": 0.1, "maximum": 256}, "pids": {"type": "integer", "minimum": 16, "maximum": 1048576}, "accelerators": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/accelerator"}, "default": []}}},
    "sandbox": {"type": "object", "additionalProperties": false, "properties": {"profile": {"enum": ["inherit", "strict", "standard", "none"], "default": "inherit"}, "readOnlyRoot": {"type": "boolean"}, "writablePaths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/absolutePath"}}, "dropAllLinuxCapabilities": {"type": "boolean"}, "addLinuxCapabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP_[A-Z0-9_]+$"}}}},
    "storageAttachment": {"type": "object", "additionalProperties": false, "required": ["resource", "mountPath"], "properties": {"resource": {"$ref": "#/$defs/id"}, "mountPath": {"$ref": "#/$defs/absolutePath"}, "access": {"enum": ["read", "write"], "default": "read"}, "target": {"type": "string"}}},
    "credentialAttachment": {"type": "object", "additionalProperties": false, "required": ["credential", "use"], "properties": {"credential": {"$ref": "#/$defs/id"}, "use": {"enum": ["file", "environment-file"]}, "mountPath": {"$ref": "#/$defs/absolutePath"}, "target": {"type": "string"}}},
    "pythonDependencies": {"title": "Python environment dependencies", "description": "Installed only inside this service's private V2 venv. The appliance/control-plane Python environment is never modified.", "type": "object", "additionalProperties": false, "properties": {"requirementsFile": {"$ref": "#/$defs/absolutePath"}, "requireHashes": {"type": "boolean", "default": true}, "projectPath": {"$ref": "#/$defs/absolutePath"}, "installProjectDependencies": {"type": "boolean", "default": false}}},
    "pythonEntrypoint": {"type": "object", "additionalProperties": false, "properties": {"module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}, "script": {"$ref": "#/$defs/absolutePath"}}, "oneOf": [{"required": ["module"], "not": {"required": ["script"]}}, {"required": ["script"], "not": {"required": ["module"]}}]},
    "runtime": {"oneOf": [{"title": "Existing systemd unit", "type": "object", "additionalProperties": false, "required": ["type", "unit"], "properties": {"type": {"const": "systemd"}, "unit": {"$ref": "#/$defs/unit"}}}, {"title": "Generic executable", "type": "object", "additionalProperties": false, "required": ["type", "command"], "properties": {"type": {"const": "exec"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "workingDirectory": {"$ref": "#/$defs/absolutePath"}, "environment": {"$ref": "#/$defs/environment"}, "user": {"type": "string"}, "group": {"type": "string"}, "restart": {"enum": ["no", "on-failure", "always"], "default": "on-failure"}, "restartSeconds": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 3}}}, {"title": "Isolated Python virtual environment", "description": "V2 creates a private venv under /var/lib/nas-control/venvs/<service-id>; packages never enter the base/control-plane Python environment.", "type": "object", "additionalProperties": false, "required": ["type", "entrypoint"], "properties": {"type": {"const": "python"}, "interpreter": {"$ref": "#/$defs/absolutePath", "default": "/run/current-system/sw/bin/python3"}, "dependencies": {"$ref": "#/$defs/pythonDependencies"}, "entrypoint": {"$ref": "#/$defs/pythonEntrypoint"}, "args": {"type": "array", "items": {"type": "string"}, "default": []}, "workingDirectory": {"$ref": "#/$defs/absolutePath"}, "environment": {"$ref": "#/$defs/environment"}, "user": {"type": "string"}, "group": {"type": "string"}, "restart": {"enum": ["no", "on-failure", "always"], "default": "on-failure"}, "restartSeconds": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 3}}}, {"title": "Podman Quadlet", "type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": {"type": {"const": "quadlet"}, "source": {"$ref": "#/$defs/absolutePath"}}}, {"title": "Podman Compose", "type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": {"type": {"const": "compose"}, "source": {"$ref": "#/$defs/absolutePath"}}}, {"title": "libvirt VM", "type": "object", "additionalProperties": false, "required": ["type", "source"], "properties": {"type": {"const": "vm"}, "source": {"$ref": "#/$defs/absolutePath"}}}, {"title": "OCI session/container", "type": "object", "additionalProperties": false, "required": ["type", "image"], "properties": {"type": {"const": "oci"}, "image": {"type": "string", "minLength": 1}, "command": {"type": "array", "items": {"type": "string"}, "default": []}, "environment": {"$ref": "#/$defs/environment"}, "user": {"type": "string"}, "pull": {"enum": ["never", "missing", "always"], "default": "missing"}}}]},
    "sessionInput": {"type": "object", "additionalProperties": false, "required": ["type", "resource", "mountPath"], "properties": {"type": {"const": "path"}, "label": {"type": "string"}, "resource": {"$ref": "#/$defs/id"}, "allowSubpath": {"type": "boolean", "default": true}, "mountPath": {"$ref": "#/$defs/absolutePath"}, "access": {"enum": ["read", "write"], "default": "read"}, "target": {"type": "string"}}},
    "routeTarget": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "port"], "properties": {"type": {"enum": ["http", "https"]}, "host": {"type": "string", "default": "127.0.0.1"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, {"type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": {"type": {"const": "unix-http"}, "path": {"$ref": "#/$defs/absolutePath"}}}]},
    "routeExposure": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "paths"], "properties": {"type": {"const": "path"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}}}, {"type": "object", "additionalProperties": false, "required": ["type", "hostname"], "properties": {"type": {"const": "hostname"}, "hostname": {"type": "string"}, "path": {"type": "string", "pattern": "^/", "default": "/"}}}]},
    "auth": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "public"}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "capability"], "properties": {"mode": {"const": "identity"}, "capability": {"type": "string"}}}, {"type": "object", "additionalProperties": false, "required": ["mode", "credential", "sources"], "properties": {"mode": {"const": "secret"}, "credential": {"$ref": "#/$defs/id"}, "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}, {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "upstream"}}}]},
    "proxy": {"type": "object", "additionalProperties": false, "properties": {"stripPrefix": {"type": "string", "pattern": "^/"}, "requestHeaders": {"type": "object", "additionalProperties": {"type": "string"}}, "removeRequestHeaders": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "responseHeaders": {"type": "object", "additionalProperties": {"type": "string"}}, "removeResponseHeaders": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "route": {"type": "object", "additionalProperties": false, "required": ["target", "exposure", "auth"], "properties": {"target": {"$ref": "#/$defs/routeTarget"}, "exposure": {"$ref": "#/$defs/routeExposure"}, "auth": {"$ref": "#/$defs/auth"}, "proxy": {"$ref": "#/$defs/proxy"}, "priority": {"type": "integer", "minimum": -1000, "maximum": 1000, "default": 0}, "portal": {"type": "object", "additionalProperties": false, "properties": {"visible": {"type": "boolean", "default": false}, "label": {"type": "string"}, "category": {"type": "string"}, "icon": {"type": "string"}}}}},
    "listener": {"type": "object", "additionalProperties": false, "required": ["protocol", "exposure"], "properties": {"protocol": {"enum": ["tcp", "udp"]}, "exposure": {"oneOf": [{"type": "object", "required": ["port"], "additionalProperties": false, "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"type": "integer", "minimum": 1, "maximum": 65535}, "end": {"type": "integer", "minimum": 1, "maximum": 65535}}}]}, "firewall": {"type": "boolean", "default": true}}},
    "service": {"title": "Managed service", "type": "object", "additionalProperties": false, "required": ["name", "enabled", "managed", "workload", "runtime"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 64}, "description": {"type": "string", "maxLength": 512}, "enabled": {"type": "boolean"}, "managed": {"type": "boolean", "default": true}, "principal": {"type": "string"}, "workload": {"$ref": "#/$defs/workload"}, "runtime": {"$ref": "#/$defs/runtime"}, "dependencies": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/dependency"}, "default": []}, "readiness": {"$ref": "#/$defs/readiness"}, "requiresCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}, "default": []}, "resources": {"$ref": "#/$defs/resources"}, "sandbox": {"$ref": "#/$defs/sandbox"}, "storage": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/storageAttachment"}, "default": []}, "credentials": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/credentialAttachment"}, "default": []}, "networkProfile": {"$ref": "#/$defs/id"}, "network": {"$ref": "#/$defs/networkPolicy"}, "sessionInputs": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/sessionInput"}, "default": {}}, "routes": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/route"}, "default": {}}, "listeners": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/listener"}, "default": {}}}}
  },
  "properties": {
    "schemaVersion": {"const": 3},
    "generation": {"type": "integer", "minimum": 1, "default": 1},
    "storageResources": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/storageResource"}, "default": {}},
    "networkProfiles": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/networkPolicy"}, "default": {}},
    "credentials": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/credential"}, "default": {}},
    "services": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/service"}}
  }
}
