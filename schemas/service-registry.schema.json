{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixos-nas.local/schemas/service-registry.schema.json",
  "$title": "NixOS NAS service endpoint registry v2 (unified)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "services"],
  "properties": {
    "schemaVersion": {"const": 2},
    "generation": {"type": "integer", "minimum": 1},
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "enabled", "runtime", "endpoints"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 64},
          "description": {"type": "string", "maxLength": 256},
          "ownership": {"enum": ["system", "runtime"], "default": "system"},
          "enabled": {"type": "boolean"},
          "generation": {"type": "integer", "minimum": 1},
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "source", "startPolicy"],
            "properties": {
              "type": {"enum": ["quadlet", "compose", "vm", "external", "native", "systemd"]},
              "source": {"type": "string", "pattern": "^(/etc/nas-control|/var/lib/nas-control/apps|systemd)/.+$"},
              "startPolicy": {"enum": ["boot", "manual", "on-demand", "disabled"]},
              "units": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]+\\.(service|socket|timer)$"}}
            }
          },
          "endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "targetPort", "exposure", "auth"],
              "properties": {
                "available": {"type": "boolean"},
                "linkKey": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                "transport": {"enum": ["http", "https", "tcp", "udp", "ws"]},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535},
                "exposure": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": {"enum": ["none", "path", "hostname", "dns", "port"]},
                    "value": {"type": "string", "minLength": 1, "maxLength": 253},
                    "prefix": {"type": "boolean", "default": true}
                  }
                },
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode"],
                  "properties": {
                    "mode": {"enum": ["public", "forward-auth", "oidc"]},
                    "allow": {"enum": ["any", "groups", "users", "all"]},
                    "groups": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}},
                    "users": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}}
                  }
                },
                "portal": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "visible": {"type": "boolean"},
                    "category": {"enum": ["Files", "Media", "AI", "Home", "Tools", "Monitoring", "Administration", "Other"]},
                    "icon": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                    "linkKey": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
