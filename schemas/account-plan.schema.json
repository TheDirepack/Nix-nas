{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixos-nas.local/schemas/account-plan.schema.json",
  "title": "NixOS NAS transient Authentik account plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["accounts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "deactivateMissingManagedAccounts": {"type": "boolean"},
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username"],
        "properties": {
          "username": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "email": {"type": "string", "minLength": 1},
          "active": {"type": "boolean"},
          "groups": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "attributes": {"type": "object"},
          "password": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
