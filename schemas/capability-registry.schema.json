{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixos-nas.local/schemas/capability-registry.schema.json",
  "title": "NixOS NAS capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identityGroups",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identityGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "administrator",
        "user",
        "guest",
        "disabled"
      ],
      "properties": {
        "administrator": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "guest": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        },
        "disabled": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]*$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "allowGroup",
          "denyGroup",
          "description",
          "owner",
          "routes",
          "administratorBypass",
          "canWakeService",
          "exposedInSetup",
          "exposedInCockpit",
          "authentikClaims",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "allowGroup": {
            "type": "string",
            "pattern": "^nas_allow_[a-z0-9_]+$"
          },
          "denyGroup": {
            "type": "string",
            "pattern": "^nas_deny_[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "administratorBypass": {
            "type": "boolean"
          },
          "canWakeService": {
            "type": "boolean"
          },
          "exposedInSetup": {
            "type": "boolean"
          },
          "exposedInCockpit": {
            "type": "boolean"
          },
          "authentikClaims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "available": {
            "type": "boolean",
            "description": "Evaluation-time configured availability. This is not runtime health, readiness, or active state."
          }
        }
      }
    }
  }
}
