from __future__ import annotations

import importlib.util
import json
import pathlib
import stat
import sys
import tempfile
import unittest
from unittest import mock

ROOT = pathlib.Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location(
    "nas_operation_journal_test", ROOT / "services" / "nas_operation_journal.py"
)
assert SPEC and SPEC.loader
journal_module = importlib.util.module_from_spec(SPEC)
sys.modules[SPEC.name] = journal_module
SPEC.loader.exec_module(journal_module)


class OperationJournalTests(unittest.TestCase):
    def test_atomic_write_sets_mode_and_replaces_complete_json(self) -> None:
        with tempfile.TemporaryDirectory() as temporary:
            path = pathlib.Path(temporary) / "nested" / "journal.json"
            journal_module.atomic_write_json(path, {"value": 1}, mode=0o640)
            self.assertEqual({"value": 1}, json.loads(path.read_text()))
            self.assertEqual(0o640, stat.S_IMODE(path.stat().st_mode))
            journal_module.atomic_write_json(path, {"value": 2}, mode=0o600)
            self.assertEqual({"value": 2}, json.loads(path.read_text()))
            self.assertEqual(0o600, stat.S_IMODE(path.stat().st_mode))
            self.assertEqual([], list(path.parent.glob(f".{path.name}.*")))

    def test_atomic_write_removes_temporary_file_after_replace_failure(self) -> None:
        with tempfile.TemporaryDirectory() as temporary:
            path = pathlib.Path(temporary) / "journal.json"
            with mock.patch.object(journal_module.os, "replace", side_effect=OSError("fail")):
                with self.assertRaisesRegex(OSError, "fail"):
                    journal_module.atomic_write_json(path, {"value": 1})
            self.assertFalse(path.exists())
            self.assertEqual([], list(path.parent.glob(f".{path.name}.*")))

    def test_load_json_distinguishes_missing_invalid_and_non_object(self) -> None:
        with tempfile.TemporaryDirectory() as temporary:
            path = pathlib.Path(temporary) / "journal.json"
            self.assertIsNone(journal_module.load_json(path))
            path.write_text("not-json")
            with self.assertRaisesRegex(journal_module.JournalError, "Invalid operation journal"):
                journal_module.load_json(path)
            path.write_text("[]")
            with self.assertRaisesRegex(journal_module.JournalError, "not a JSON object"):
                journal_module.load_json(path)

    def test_open_resume_and_terminal_state_semantics(self) -> None:
        with (
            tempfile.TemporaryDirectory() as temporary,
            mock.patch.object(journal_module.time, "time", return_value=10),
        ):
            path = pathlib.Path(temporary) / "journal.json"
            first = journal_module.OperationJournal.open(
                path, workflow="setup", fingerprint="same", metadata={"one": 1}
            )
            self.assertEqual("pending", first.value["status"])
            first.value["status"] = "failed"
            first.save()
            resumed = journal_module.OperationJournal.open(path, workflow="setup", fingerprint="same")
            self.assertEqual("resuming", resumed.value["status"])
            resumed.value["status"] = "complete"
            resumed.save()
            replacement = journal_module.OperationJournal.open(path, workflow="setup", fingerprint="new")
            self.assertEqual("pending", replacement.value["status"])
            self.assertEqual("new", replacement.value["fingerprint"])

    def test_open_rejects_wrong_workflow_fingerprint_and_manual_recovery(self) -> None:
        cases = [
            ({"schemaVersion": 2, "workflow": "setup", "fingerprint": "a", "status": "failed"}, "reconciliation"),
            ({"schemaVersion": 1, "workflow": "other", "fingerprint": "a", "status": "failed"}, "reconciliation"),
            ({"schemaVersion": 1, "workflow": "setup", "fingerprint": "other", "status": "failed"}, "different setup"),
            (
                {"schemaVersion": 1, "workflow": "setup", "fingerprint": "a", "status": "manual-recovery-required"},
                "explicit recovery",
            ),
        ]
        for value, expected in cases:
            with self.subTest(expected=expected), tempfile.TemporaryDirectory() as temporary:
                path = pathlib.Path(temporary) / "journal.json"
                path.write_text(json.dumps(value))
                with self.assertRaisesRegex(journal_module.JournalError, expected):
                    journal_module.OperationJournal.open(path, workflow="setup", fingerprint="a")

    def test_manual_recovery_acknowledgement_is_strict_and_durable(self) -> None:
        with tempfile.TemporaryDirectory() as temporary:
            path = pathlib.Path(temporary) / "journal.json"
            with self.assertRaisesRegex(journal_module.JournalError, "No operation journal"):
                journal_module.OperationJournal.acknowledge_manual_recovery(path, workflow="setup", note="fixed")
            path.write_text(json.dumps({"schemaVersion": 1, "workflow": "other", "status": "manual-recovery-required"}))
            with self.assertRaisesRegex(journal_module.JournalError, "does not belong"):
                journal_module.OperationJournal.acknowledge_manual_recovery(path, workflow="setup", note="fixed")
            path.write_text(json.dumps({"schemaVersion": 1, "workflow": "setup", "status": "failed"}))
            with self.assertRaisesRegex(journal_module.JournalError, "not awaiting"):
                journal_module.OperationJournal.acknowledge_manual_recovery(path, workflow="setup", note="fixed")
            path.write_text(json.dumps({"schemaVersion": 1, "workflow": "setup", "status": "manual-recovery-required"}))
            result = journal_module.OperationJournal.acknowledge_manual_recovery(
                path, workflow="setup", note="verified storage"
            )
            self.assertEqual("reconciled", result.value["status"])
            self.assertEqual("verified storage", result.value["recoveryNote"])

    def test_step_and_workflow_lifecycle_clears_stale_errors(self) -> None:
        with tempfile.TemporaryDirectory() as temporary:
            path = pathlib.Path(temporary) / "journal.json"
            journal = journal_module.OperationJournal.open(path, workflow="setup", fingerprint="a")
            journal.value["steps"]["storage"] = {"error": "old"}
            journal.start_step("storage")
            self.assertEqual("running", journal.value["status"])
            self.assertNotIn("error", journal.value["steps"]["storage"])
            journal.fail_step("storage", "unsafe", manual_recovery=True)
            self.assertEqual("manual-recovery-required", journal.value["status"])
            self.assertFalse(journal.step_complete("storage"))
            journal.start_step("storage")
            journal.complete_step("storage", {"pool": "tank"})
            self.assertTrue(journal.step_complete("storage"))
            self.assertEqual({"pool": "tank"}, journal.result("storage"))
            self.assertIsNone(journal.result("missing"))
            journal.fail("later", manual_recovery=False)
            self.assertEqual("failed", journal.value["status"])
            journal.complete({"ok": True})
            self.assertEqual("complete", journal.value["status"])
            self.assertEqual({"ok": True}, journal.value["result"])


if __name__ == "__main__":
    unittest.main()


class SetupFlowTests(unittest.TestCase):
    """Tests for the new setup flow expectations."""
    
    def test_admin_username_not_default(self):
        """Ensure the admin username is not the default 'admin'."""
        # Read the admin username from configuration
        admin_user = os.environ.get("NAS_ADMIN_USER", "admin")
        self.assertNotEqual(admin_user, "admin",
            "Admin username should not be the default 'admin'")
    
    def test_password_handling_secure(self):
        """Verify passwords are handled securely (hashed, not stored plaintext)."""
        # Read the password hash from the system
        password_hash = self._get_password_hash()
        self.assertIsNotNone(password_hash,
            "Password hash should exist")
        self.assertNotEqual(password_hash, "plaintext",
            "Password should not be stored as plaintext")
        self.assertTrue(len(password_hash) > 10,
            "Password hash should be sufficiently long")
    
    def test_no_stored_credentials(self):
        """Verify no insecurely stored credentials exist."""
        # Check that no plaintext credentials are stored
        creds = self._check_for_plaintext_creds()
        self.assertEqual(creds, [],
            "No plaintext credentials should be stored")
    
    def test_keypass_password_stored_encrypted(self):
        """Verify KeePass password is stored encrypted."""
        kp_password = self._get_keypass_password()
        self.assertIsNotNone(kp_password,
            "KeePass password should exist")
        # Verify it's not empty or default
        self.assertNotEqual(kp_password, "",
            "KeePass password should not be empty")
        self.assertNotEqual(kp_password, "default",
            "KeePass password should not be the default")
    
    def test_system_password_hashed(self):
        """Verify system account password is hashed."""
        sys_pass = self._get_system_password()
        self.assertIsNotNone(sys_pass,
            "System password should exist")
        self.assertNotEqual(sys_pass, "hashed",
            "System password should be hashed, not stored as 'hashed' string")
        # Verify it looks like a hash (starts with known prefix or is sufficiently long)
        self.assertTrue(len(sys_pass) > 20,
            "System password hash should be sufficiently long")
    
    def test_authentik_hashed(self):
        """Verify Authentik credentials are hashed."""
        auth_hash = self._get_authentik_hash()
        self.assertIsNotNone(auth_hash,
            "Authentik hash should exist")
        self.assertNotEqual(auth_hash, "plaintext",
            "Authentik credential should not be plaintext")
    
    def _get_password_hash(self):
        """Helper to get password hash from system."""
        # Read from appropriate location
        try:
            with open("/run/nas-secrets/admin-password-hash", "r") as f:
                return f.read().strip()
        except (FileNotFoundError, IOError):
            # Try alternative location
            try:
                with open("/etc/nas/admin-password-hash", "r") as f:
                    return f.read().strip()
            except (FileNotFoundError, IOError):
                return None
    
    def _check_for_plaintext_creds(self):
        """Check for any plaintext credentials stored."""
        plaintext_creds = []
        # Check common locations for plaintext credentials
        locations = [
            "/run/nas-secrets/admin-password",
            "/etc/nas/admin-password",
            "/var/lib/nas-secrets/admin-password",
        ]
        for loc in locations:
            try:
                with open(loc, "r") as f:
                    content = f.read().strip()
                    if content and content != "placeholder" and not content.startswith("$"):
                        plaintext_creds.append(loc)
            except (FileNotFoundError, IOError):
                pass
        return plaintext_creds
    
    def _get_keypass_password(self):
        """Helper to get KeePass database password."""
        try:
            with open("/var/lib/nas-secrets/NAS.kdbx/password", "r") as f:
                return f.read().strip()
        except (FileNotFoundError, IOError):
            return None
    
    def _get_system_password(self):
        """Helper to get system account password hash."""
        try:
            with open("/run/nas-secrets/system-password-hash", "r") as f:
                return f.read().strip()
        except (FileNotFoundError, IOError):
            return None
    
    def _get_authentik_hash(self):
        """Helper to get Authentik credential hash."""
        try:
            with open("/run/nas-secrets/authentik-hash", "r") as f:
                return f.read().strip()
        except (FileNotFoundError, IOError):
            return None


class SetupFlowTests(unittest.TestCase):
    """Comprehensive tests for the setup flow expectations."""
    
    def test_setup_html_has_username_field(self):
        """Verify setup.html contains admin username field."""
        html_path = pathlib.Path(ROOT / "lib/web/portal-static/setup.html")
        self.assertTrue(html_path.exists(), "setup.html should exist")
        content = html_path.read_text()
        self.assertIn('name="admin-user"', content,
            "setup.html should have admin username field")
        self.assertIn('type="text"', content,
            "Username field should be text type")
    
    def test_setup_html_has_password_field(self):
        """Verify setup.html contains admin password field."""
        html_path = pathlib.Path(ROOT / "lib/web/portal-static/setup.html")
        content = html_path.read_text()
        self.assertIn('name="admin-pass"', content,
            "setup.html should have admin password field")
        self.assertIn('type="password"', content,
            "Password field should be password type")
    
    def test_caddy_redirects_root_to_setup(self):
        """Verify Caddy config redirects root to setup."""
        # Read the generated Caddyfile
        bootstrap_path = pathlib.Path(ROOT / "modules/nas/config/caddy-bootstrap.nix")
        self.assertTrue(bootstrap_path.exists(),
            "caddy-bootstrap.nix should exist")
        content = bootstrap_path.read_text()
        self.assertIn('redir /setup 303', content,
            "Caddy config should redirect / to /setup")
        self.assertIn('handle_path /setup', content,
            "Caddy config should have /setup handler")
    
    def test_no_plaintext_credentials_stored(self):
        """Verify no plaintext credentials are stored in system."""
        # Check common locations for plaintext credentials
        plaintext_locations = [
            "/run/nas-secrets/admin-password",
            "/etc/nas/admin-password",
            "/var/lib/nas-secrets/admin-password",
        ]
        found_plaintext = []
        for loc in plaintext_locations:
            try:
                if pathlib.Path(loc).exists():
                    content = pathlib.Path(loc).read_text().strip()
                    # Check it's not a hash (doesn't start with $ or is very long)
                    if content and not content.startswith("$") and len(content) < 50:
                        found_plaintext.append(loc)
            except Exception:
                pass
        self.assertEqual(found_plestext, [],
            f"No plaintext credentials should be stored at: {found_plaintext}")
    
    def test_keypass_db_initialized(self):
        """Verify KeePass database is initialized after setup."""
        kp_path = pathlib.Path("/var/lib/nas-secrets/NAS.kdbx")
        self.assertTrue(kp_path.exists(),
            "KeePass database should exist after setup")
        # Check it has content
        self.assertGreater(kp_path.stat().st_size, 0,
            "KeePass database should have content")
        # Check it's not the default/setup password
        content = kp_path.read_text()[:100]
        self.assertNotIn("default", content.lower(),
            "KeePass should not have default password")
    
    def test_system_account_not_default(self):
        """Verify system admin account is not default 'admin'."""
        # Check the admin username configuration
        admin_user = os.environ.get("NAS_ADMIN_USER", "admin")
        self.assertNotEqual(admin_user, "admin",
            "System admin username should not be 'admin'")
    
    def test_authentik_admin_configured(self):
        """Verify Authentik admin account is configured."""
        # Check for Authentik admin configuration
        authentik_config = pathlib.Path("/etc/authentik")
        # Check for admin user configuration
        auth_config = pathlib.Path("/etc/authentik/users")
        # At minimum, the config directory should exist or have been set up
        # during the setup flow
        self.assertTrue(authentik_config.exists() or auth_config.exists(),
            "Authentik configuration should exist after setup")
    
    def test_caddy_certificates_generated(self):
        """Verify Caddy generated certificates during setup."""
        pki_dir = pathlib.Path("/var/lib/caddy/.local/share/caddy/pki")
        self.assertTrue(pki_dir.exists(),
            "Caddy PKI directory should exist after setup")
        # Check for certificate files
        cert_files = list(pki_dir.glob("*.key")) + list(pki_dir.glob("*.crt"))
        self.assertGreater(len(cert_files), 0,
            "Caddy should have generated certificates during setup")
    
    def test_no_default_credentials_remaining(self):
        """Verify no default or temporary credentials remain."""
        # Check for common default credential files
        default_files = [
            "/run/nas-secrets/.default-admin-password",
            "/var/lib/nas-secrets/.default-credentials",
            "/etc/nas/.default-setup",
        ]
        found_defaults = []
        for f in default_files:
            if pathlib.Path(f).exists():
                found_defaults.append(f)
        self.assertEqual(found_defaults, [],
            f"No default credential files should remain: {found_defaults}")
    
    def test_setup_completion_marker(self):
        """Verify setup completion marker exists."""
        completion_marker = pathlib.Path("/run/nas-setup.completed")
        self.assertTrue(completion_marker.exists(),
            "Setup completion marker should exist after setup")
        # Check it has proper content
        content = completion_marker.read_text().strip()
        self.assertIn("complete", content.lower(),
            "Setup completion marker should indicate completion")
