{ config, lib, pkgs, nasInternal, ... }:

let
  storePath = "/var/lib/nas-control/services.json";
  effectivePath = "/run/nas-control/effective-endpoints.json";
  fragmentPath = "/run/nas-control/caddy-managed.conf";
  managedService = "${nasInternal.nasPythonApplication}/bin/nas-managed-service";
in
{
  config = lib.mkIf true {
    systemd.tmpfiles.rules = [
      "d /var/lib/nas-control 0750 nas-feature-gate nas-feature-control -"
      "d /var/lib/nas-control/apps 0750 root root -"
      "d /run/nas-control 0755 root root -"
      "f ${storePath} 0600 nas-feature-gate nas-feature-control - {\"schemaVersion\":2,\"services\":{}}"
      "f ${fragmentPath} 0644 root root - \"# Managed-services Caddy fragment — generated by nas-managed-service\\n\""
    ];

    # Fast projection reconciliation for mutations. The short-lived
    # orchestrator also validates/reloads Caddy; it does not remain resident.
    systemd.services.nas-managed-services-reconcile = {
      description = "Reconcile managed service registry, Caddy, and portal";
      after = [ "network.target" ];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = "${managedService} reconcile";
        RemainAfterExit = false;
      };
    };

    systemd.paths.nas-managed-services-reconcile = {
      description = "Watch for managed service store changes";
      wantedBy = [ "multi-user.target" ];
      pathConfig.PathChanged = storePath;
    };

    # Boot recovery additionally restores missing runtime objects. Keeping this
    # separate prevents an ordinary services.json write from restarting every
    # healthy workload.
    systemd.services.nas-managed-services-boot = {
      description = "Restore managed service runtime state at boot";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" "caddy.service" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        Type = "oneshot";
        ExecStart = "${managedService} reconcile --apply-runtimes";
        RemainAfterExit = false;
      };
    };

    environment.etc."nas-control/effective-endpoints.json".source = effectivePath;

    services.caddy.virtualHosts.${config.networking.hostName + ".local"}.extraConfig = lib.mkAfter ''
      import ${fragmentPath}
    '';
  };
}
