{ config, lib, pkgs, nasInternal, ... }:

let
  storePath = "/var/lib/nas-control/services.yaml";
  schemaPath = "/etc/nas-control/managed-services-v3.schema.json";
  effectivePath = "/run/nas-control/effective-endpoints.json";
  fragmentPath = "/run/nas-control/caddy-managed.conf";
  secretReady = "${nasInternal.secretRoot}/ready";
in
{
  config = {
    systemd.tmpfiles.rules = [
      "d /var/lib/nas-control 0750 nas-feature-gate nas-feature-control -"
      "d /var/lib/nas-control/apps 0750 nas-feature-gate nas-feature-control -"
      "d /var/lib/nas-control/venvs 0750 root root -"
      "d /run/nas-control 0755 root root -"
      "d /var/lib/copyparty/user.d 0750 copyparty copyparty -"
      "f ${storePath} 0600 nas-feature-gate nas-feature-control - {\"schemaVersion\":3,\"services\":{}}"
      "f ${fragmentPath} 0644 root root - \"# Managed-services Caddy sites — generated by nas-v2-runtime\\n\""
    ];

    environment.etc."nas-control/managed-services-v3.schema.json".source = ../../../schemas/managed-services-v3.schema.json;

    systemd.services.nas-managed-services-reconcile = {
      description = "Compile and apply the Managed Services V2 schema";
      wantedBy = [ "nas-protected-services.target" ];
      partOf = [ "nas-protected-services.target" ];
      requires = [ "nas-zfs-mount-guard.service" "nas-identity-sync.service" "caddy.service" ];
      after = [
        "network-online.target"
        "nas-zfs-mount-guard.service"
        "nas-identity-sync.service"
        "caddy.service"
      ];
      unitConfig.ConditionPathExists = secretReady;
      serviceConfig = {
        Type = "oneshot";
        ExecStart = ''
          ${nasInternal.nasPythonApplication}/bin/nas-v2-runtime apply \
            --spec ${storePath} \
            --schema ${schemaPath} \
            --effective ${effectivePath}
        '';
        RemainAfterExit = false;
        NoNewPrivileges = true;
        PrivateTmp = true;
      };
    };

    systemd.paths.nas-managed-services-reconcile = {
      description = "Watch the GUI-owned Managed Services V2 desired state";
      wantedBy = [ "nas-protected-services.target" ];
      partOf = [ "nas-protected-services.target" ];
      unitConfig.ConditionPathExists = secretReady;
      pathConfig.PathChanged = storePath;
    };

    # The existing lifecycle reaper remains temporarily while daemon/session
    # activation is migrated onto the schema runtime. It consumes the same
    # effective state generated above and no longer owns desired-state parsing.
    systemd.services.nas-managed-services-reap = {
      description = "Stop idle Managed Services V2 on-demand applications";
      partOf = [ "nas-protected-services.target" ];
      unitConfig.ConditionPathExists = secretReady;
      serviceConfig = {
        Type = "oneshot";
        ExecStart = "${nasInternal.nasPythonApplication}/bin/nas-managed-service reap";
        NoNewPrivileges = true;
        PrivateTmp = true;
      };
    };

    systemd.timers.nas-managed-services-reap = {
      description = "Periodically reap idle Managed Services V2 on-demand applications";
      wantedBy = [ "nas-protected-services.target" ];
      partOf = [ "nas-protected-services.target" ];
      unitConfig.ConditionPathExists = secretReady;
      timerConfig = {
        OnActiveSec = "2m";
        OnUnitActiveSec = "1m";
        AccuracySec = "15s";
        Persistent = false;
      };
    };

    environment.etc."nas-control/effective-endpoints.json".source = effectivePath;

    services.caddy.extraConfig = lib.mkAfter ''
      import ${fragmentPath}
    '';
    services.caddy.virtualHosts.${config.networking.hostName + ".local"}.extraConfig = lib.mkAfter ''
      import nas_managed_paths
    '';
    systemd.services.caddy.restartTriggers = [ fragmentPath ];
  };
}
