{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "first-run-wizard form schema",
  "type": "object",
  "properties": {
    "adminUsername": {
      "type": "string",
      "description": "Admin username for Authentik and Linux account"
    },
    "adminEmail": {
      "type": "string",
      "format": "email",
      "description": "Admin email address",
      "default": "admin@example.com"
    },
    "adminPassword": {
      "type": "string",
      "description": "Admin password for Authentik and Linux account",
      "minLength": 8
    },
    "useSamePassword": {
      "type": "boolean",
      "description": "Use same password for KeePassXC master",
      "default": true
    },
    "keePassMasterPassword": {
      "type": "string",
      "description": "KeePassXC master password (if different from admin password)",
      "minLength": 8
    },
    "keePassMasterPasswordConfirm": {
      "type": "string",
      "description": "Confirm KeePassXC master password"
    },
    "authentikExternalUrl": {
      "type": "string",
      "format": "uri",
      "description": "Authentik external URL (full URL with https:// and port)",
      "default": "https://"
    },
    "createOutpost": {
      "type": "boolean",
      "description": "Configure embedded outpost",
      "default": true
    },
    "createProviderApp": {
      "type": "boolean",
      "description": "Create initial OAuth2 provider + Application",
      "default": true
    },
    "zfsPoolName": {
      "type": "string",
      "description": "ZFS pool name (read-only, from local.nix)",
      "default": "tank"
    },
    "zfsPoolDevices": {
      "type": "string",
      "description": "ZFS pool devices (read-only, from local.nix)",
      "default": "/dev/sdb /dev/sdc"
    }
  },
  "required": ["adminUsername", "adminEmail", "adminPassword"]
}
