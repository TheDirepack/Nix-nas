{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "first-run-wizard form schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adminUsername": {
      "type": "string",
      "description": "New Linux administrator username",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z_][a-z0-9_-]*$"
    },
    "adminEmail": {
      "type": "string",
      "format": "email",
      "description": "Administrator email address"
    },
    "adminPassword": {
      "type": "string",
      "description": "Linux administrator password",
      "minLength": 15
    },
    "adminPasswordConfirm": {
      "type": "string",
      "description": "Confirm Linux administrator password",
      "minLength": 15
    },
    "keePassMasterPassword": {
      "type": "string",
      "description": "User-owned permanent KeePassXC master password",
      "minLength": 15
    },
    "keePassMasterPasswordConfirm": {
      "type": "string",
      "description": "Confirm permanent KeePassXC master password",
      "minLength": 15
    },
    "authentikAdministratorPassword": {
      "type": "string",
      "description": "Authentik human administrator password",
      "minLength": 15
    },
    "authentikAdministratorPasswordConfirm": {
      "type": "string",
      "description": "Confirm Authentik human administrator password",
      "minLength": 15
    },
    "authentikExternalUrl": {
      "type": "string",
      "format": "uri",
      "description": "Authentik external URL"
    },
    "zfsPoolName": {
      "type": "string",
      "description": "ZFS pool name (read-only, from appliance configuration)",
      "default": "tank"
    },
    "zfsPoolDevices": {
      "type": "string",
      "description": "ZFS pool devices (read-only, from appliance configuration)"
    }
  },
  "required": [
    "adminUsername",
    "adminEmail",
    "adminPassword",
    "adminPasswordConfirm",
    "keePassMasterPassword",
    "keePassMasterPasswordConfirm",
    "authentikAdministratorPassword",
    "authentikAdministratorPasswordConfirm",
    "authentikExternalUrl"
  ]
}
